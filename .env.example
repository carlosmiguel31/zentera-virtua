# =============================================================================
# Zentera Virtua — Landing page · Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores antes de rodar o projeto.
# ATENÇÃO: variáveis com prefixo VITE_ são embutidas no bundle e ficam VISÍVEIS
# no navegador. Nunca coloque tokens, chaves ou segredos aqui.
# =============================================================================

# URL do webhook que receberá os envios do formulário de contato (POST em JSON).
# Ex.: uma URL pública de n8n, Make, API própria ou função serverless.
# Se o destino exigir um segredo/token, NÃO o coloque aqui — use um backend
# intermediário que guarde o segredo do lado do servidor.
VITE_CONTACT_WEBHOOK_URL=

# URL pública final do site, usada para gerar canonical, og:url e og:image
# absolutos. Ex.: https://www.seudominio.com.br
# Enquanto vazia, o site funciona normalmente e essas tags são omitidas ou
# usam caminhos relativos (nenhuma URL falsa é publicada).
VITE_SITE_URL=
