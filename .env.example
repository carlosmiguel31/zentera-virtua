# =============================================================================
# Zentera Virtua — Landing page · Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores antes de rodar o projeto.
# =============================================================================

# URL pública final do site, usada para canonical, og:url e og:image absolutos.
VITE_SITE_URL=https://zenteravirtua.com.br

# Microsoft 365 / Microsoft Graph — SOMENTE NO SERVIDOR.
# Não use prefixo VITE_ nestas variáveis: elas contêm credenciais privadas.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Caixa postal usada para enviar e receber os contatos do formulário.
CONTACT_FROM=contato@zenteravirtua.com.br
CONTACT_TO=contato@zenteravirtua.com.br

# Proteção simples contra abuso por IP. O armazenamento é em memória e é
# reiniciado junto com o processo da aplicação.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
